---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import Marquee from '../components/Marquee.astro';
import Stats from '../components/Stats.astro';
import Projects from '../components/Projects.astro';
import WorkRail from '../components/WorkRail.astro';
import Testimonials from '../components/Testimonials.astro';
import Cta from '../components/Cta.astro';
import CaseDialog from '../components/CaseDialog.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const name = "I'M AVIRAL";
---

<Base intro>
  <section class="hero">
    <div class="hero__grid wrap">
      <p class="hero__tagline" data-hero>{site.tagline}</p>

      <div class="hero__center">
        <div class="hero__avatar" data-hero-avatar>
          <Avatar />
        </div>
        <h1 class="hero__name" aria-label={name}>
          {
            name.split('').map((ch) => (
              <span class="char" aria-hidden="true">
                <span data-hero-char>{ch === ' ' ? ' ' : ch}</span>
              </span>
            ))
          }
        </h1>
        <p class="hero__role" data-hero>{site.role}</p>
      </div>

      <ul class="hero__services" data-hero>
        {site.services.map((s) => <li>{s}</li>)}
      </ul>
    </div>

    <div class="hero__bottom wrap" data-hero>
      <div class="hero__socials">
        <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
        <a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a>
      </div>
      <span class="hero__scroll">Scroll ↓</span>
      <span></span>
    </div>
  </section>

  <section class="brands" aria-labelledby="brands-title">
    <div class="wrap brands__head">
      <span class="eyebrow" id="brands-title">Brands I've worked with</span>
    </div>
    <Marquee />
  </section>

  <section class="wrap intro section" aria-label="In short">
    <p class="intro__text" data-reveal>
      I'm a marketer, creative director and content creator. I run <strong>Dot Engage</strong>, a UGC ad agency — I write
      the strategy, direct the creators and obsess over the first three seconds. Years as a video editor mean I know what
      happens after the shoot too.
    </p>
    <Stats />
  </section>

  <section class="section wrap" aria-labelledby="projects-title">
    <div class="section-head">
      <div>
        <span class="eyebrow">Things I've built</span>
        <h2 class="h-section" id="projects-title">SaaS side projects</h2>
      </div>
      <p class="lede">Small products I designed and shipped. Tap one to see what it does, then take it for a spin.</p>
    </div>
    <Projects />
  </section>

  <WorkRail />
  <Testimonials />
  <Cta />
  <CaseDialog />
</Base>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 12px 24px;
    color: var(--ink);
  }
  .hero__grid {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
  }
  .hero__tagline {
    max-width: 26ch;
    font-size: 13px;
    font-weight: 600;
  }
  .hero__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__avatar {
    width: clamp(220px, 26vw, 340px);
    display: flex;
    justify-content: center;
  }
  .hero__name {
    margin-top: clamp(16px, 3vh, 28px);
    font-size: clamp(3rem, 8.5vw, 7rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--orange);
    white-space: nowrap;
  }
  .char {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.04em;
  }
  .char > span {
    display: inline-block;
  }
  .hero__role {
    margin-top: 12px;
    font-size: 13px;
    font-weight: 700;
  }
  .hero__services {
    justify-self: end;
    text-align: right;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.9;
  }
  .hero__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    font-size: 12px;
    font-weight: 700;
    margin-top: 20px;
  }
  .hero__socials {
    display: flex;
    gap: 14px;
  }
  .hero__socials a {
    transition:
      color 0.2s,
      transform 0.4s var(--ease);
  }
  .hero__socials a:hover {
    color: var(--text);
    transform: translateY(-2px);
  }
  .hero__scroll {
    animation: bob 2s var(--ease-io) infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(5px);
    }
  }

  .brands {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    padding-top: clamp(32px, 4vw, 48px);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    padding-top: clamp(48px, 6vw, 80px);
  }
  .intro__text {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    font-weight: 500;
    max-width: 58ch;
    color: var(--text);
  }
  .intro__text strong {
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .hero__grid {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      align-content: center;
    }
    .hero__center {
      order: -1;
    }
    .hero__tagline {
      max-width: 34ch;
    }
    .hero__services {
      justify-self: center;
      text-align: center;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
      line-height: 1.4;
    }
    .hero__services li {
      padding: 4px 10px;
      border-radius: 999px;
      background: var(--tint);
      font-size: 12px;
    }
  }
  @media (max-width: 560px) {
    .hero__bottom {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .hero__scroll {
      display: none;
    }
  }
</style>

<style is:global>
  .js [data-hero],
  .js [data-hero-avatar] {
    opacity: 0;
  }
  .js [data-hero-char] {
    transform: translateY(105%);
  }
  @media (prefers-reduced-motion: reduce) {
    .js [data-hero],
    .js [data-hero-avatar] {
      opacity: 1;
    }
    .js [data-hero-char] {
      transform: none;
    }
  }
</style>

<script>
  import { gsap, introDone, reduced } from '../scripts/motion';

  introDone.then(() => {
    if (reduced) return;
    gsap
      .timeline({ defaults: { ease: 'power4.out' } })
      .fromTo(
        '[data-hero-avatar]',
        { opacity: 0, scale: 0.6, rotate: -8, y: 40 },
        { opacity: 1, scale: 1, rotate: 0, y: 0, duration: 1.1, ease: 'elastic.out(1, 0.6)' },
      )
      .to('[data-hero-char]', { y: 0, duration: 0.9, stagger: 0.035 }, 0.15)
      .to('[data-hero]', { opacity: 1, duration: 0.8, stagger: 0.08 }, 0.45);
  });
</script>
