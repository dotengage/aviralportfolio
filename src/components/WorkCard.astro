---
import { Image } from 'astro:assets';
import { categoryLabel, type CaseStudy } from '../data/cases';
import Icon from './Icon.astro';
import { url } from '../data/site';

interface Props {
  item: CaseStudy;
  index: number;
  variant?: 'rail' | 'grid';
  hidden?: boolean;
}
const { item, index, variant = 'grid', hidden = false } = Astro.props;
---

<a
  href={url(`/work#${item.slug}`)}
  class:list={['card', `card--${variant}`]}
  data-case-open={item.slug}
  data-category={item.category}
  hidden={hidden}
>
  <div class:list={['card__cover', !item.cover && 'ph']}>
    {
      item.cover ? (
        <Image src={item.cover} alt="" widths={[360, 720]} sizes="(max-width: 760px) 80vw, 360px" />
      ) : (
        <div class="card__ph">
          <span class="card__ph-brand">{item.brand}</span>
          {item.placeholder && <span class="ph-badge">PLACEHOLDER</span>}
        </div>
      )
    }
    <span class="card__cat">{categoryLabel(item.category)}</span>
    {
      item.shorts.length > 0 && (
        <span class="card__play">
          <Icon name="play" size={14} /> {item.shorts.length}
        </span>
      )
    }
  </div>
  <div class="card__body">
    <span class="card__num">{String(index + 1).padStart(2, '0')}</span>
    <div>
      <h3 class="card__title">{item.title}</h3>
      <p class="card__brand">{item.brand} · {item.year}</p>
    </div>
    <span class="card__arrow"><Icon name="arrow" size={18} /></span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-radius: var(--radius);
  }
  .card[hidden] {
    display: none;
  }
  .card--rail {
    flex: 0 0 auto;
    width: clamp(240px, 26vw, 340px);
    scroll-snap-align: start;
  }
  .card__cover {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    transform: translateZ(0);
  }
  .card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .card:hover .card__cover img {
    transform: scale(1.05);
  }
  .card__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transition: transform 0.9s var(--ease);
  }
  .card:hover .card__ph {
    transform: scale(1.05);
  }
  .card__ph-brand {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    text-transform: uppercase;
  }
  .card__cat,
  .card__play {
    position: absolute;
    top: 12px;
    padding: 5px 10px;
    border-radius: 999px;
    background: #fff;
    font-size: 11px;
    font-weight: 700;
  }
  .card__cat {
    left: 12px;
  }
  .card__play {
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--text);
    color: #fff;
  }
  .card__body {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
    align-items: start;
  }
  .card__num {
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    padding-top: 3px;
  }
  .card__title {
    font-size: 14px;
    font-weight: 800;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .card__brand {
    font-size: 12px;
    color: var(--muted);
  }
  .card__arrow {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line);
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.5s var(--ease);
  }
  .card:hover .card__arrow {
    background: var(--text);
    color: #fff;
    transform: rotate(45deg);
  }
</style>
