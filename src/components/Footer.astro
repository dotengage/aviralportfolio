---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<footer class="footer">
  <div class="footer__socials">
    <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram">
      <Icon name="instagram" size={18} /><span>{site.instagramHandle}</span>
    </a>
    <a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
      <Icon name="linkedin" size={18} /><span>LinkedIn</span>
    </a>
  </div>
  <a class="footer__status" href="/contact"><span class="dot" aria-hidden="true"></span>Available for projects</a>
  <p class="footer__copy">© 2026 {site.short}</p>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 28px var(--gutter);
    width: 100%;
    max-width: calc(var(--maxw) + 2 * var(--gutter));
    margin-inline: auto;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
  }
  .footer::before {
    content: '';
    grid-column: 1 / -1;
    height: 1.5px;
    margin-bottom: 8px;
    background: var(--line);
  }
  .footer__socials {
    display: flex;
    gap: 18px;
  }
  .footer__socials a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: color 0.2s;
  }
  .footer__socials a:hover {
    color: var(--orange);
  }
  .footer__status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .dot {
    width: 8px;
    height: 8px;
    background: var(--orange);
    border-radius: 2px;
    animation: blink 1.6s steps(2, jump-none) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }
  .footer__copy {
    justify-self: end;
  }
  @media (max-width: 760px) {
    .footer {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding-bottom: calc(96px + env(safe-area-inset-bottom));
    }
    .footer__copy {
      justify-self: center;
    }
  }
</style>
