---
/**
 * One <dialog> per page + an inert <template> per case study.
 * Any element with [data-case-open="slug"] opens it; /work#slug deep-links.
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { getCases, filterNames } from '../data/cases';
import ShortEmbed from './ShortEmbed.astro';
import Icon from './Icon.astro';

const cases = await Promise.all(
  (await getCases()).map(async (c) => ({
    ...c,
    names: await filterNames(c),
    Content: (await render(c.entry)).Content,
  })),
);
---

<dialog class="case" data-case-dialog aria-labelledby="case-title" data-lenis-prevent>
  <div class="case__sheet">
    <button class="case__close" data-case-close aria-label="Close case study">
      <Icon name="close" size={22} />
    </button>
    <div class="case__content" data-case-content></div>
  </div>
</dialog>

{
  cases.map((c) => (
    <template data-case-template={c.slug}>
      <article class="cs">
        <header class="cs__head">
          <div class="cs__tags">
            {c.names.map((n) => (
              <span class="tag">{n}</span>
            ))}
            <span class="tag">{c.year}</span>
            {c.placeholder && <span class="ph-badge">PLACEHOLDER</span>}
          </div>
          <p class="cs__brand">{c.brand}</p>
          <h2 class="cs__title" id="case-title">
            {c.title}
          </h2>
          <p class="cs__summary">{c.summary}</p>
        </header>

        <div class:list={['cs__cover', !c.cover && 'ph']}>
          {c.cover ? (
            <Image src={c.cover} alt="" widths={[640, 1200]} sizes="(max-width: 900px) 92vw, 880px" />
          ) : (
            <span class="ph-badge">COVER IMAGE</span>
          )}
        </div>

        <dl class="cs__facts">
          <div>
            <dt>Role</dt>
            <dd>{c.role.join(', ') || '—'}</dd>
          </div>
          <div>
            <dt>Work delivered</dt>
            <dd>{c.deliverables.join(', ') || '—'}</dd>
          </div>
        </dl>

        <div class="cs__story">
          <c.Content />
        </div>

        {c.results.length > 0 && (
          <ul class="cs__results">
            {c.results.map((r) => (
              <li>
                <strong>{r.value}</strong>
                <span>{r.label}</span>
              </li>
            ))}
          </ul>
        )}

        {c.gallery.length > 0 && (
          <div class="cs__gallery">
            {c.gallery.map((img) => (
              <Image src={img} alt="" widths={[480, 960]} sizes="(max-width: 760px) 92vw, 440px" loading="lazy" />
            ))}
          </div>
        )}

        <section class="cs__block cs__block--wide">
          <h3>The videos</h3>
          <div class="cs__shorts">
            {c.shorts.length ? (
              c.shorts.map((id, i) => <ShortEmbed id={id} title={`${c.brand} — video ${i + 1}`} />)
            ) : (
              <>
                <ShortEmbed />
                <ShortEmbed />
                <ShortEmbed />
              </>
            )}
          </div>
        </section>

        {c.testimonial && (
          <figure class="cs__feedback">
            <figcaption class="cs__feedback-label">Client feedback</figcaption>
            <svg class="cs__feedback-mark" viewBox="0 0 32 24" aria-hidden="true">
              <path d="M0 24V14C0 6 4.5 1.3 12.6 0l1.3 3.2C9.3 4.6 7.2 7.4 7 11h6v13H0Zm18 0V14c0-8 4.5-12.7 12.6-14L32 3.2C27.3 4.6 25.2 7.4 25 11h6v13H18Z" />
            </svg>
            {c.testimonial.quote && <blockquote>{c.testimonial.quote}</blockquote>}
            {c.testimonial.screenshots.length > 0 && (
              <div class="cs__feedback-shots">
                {c.testimonial.screenshots.map((img, i) => (
                  <a href={img.src} target="_blank" rel="noopener" aria-label={`Open feedback screenshot ${i + 1}`}>
                    <Image src={img} alt={`Feedback screenshot ${i + 1}`} widths={[320, 640]} sizes="300px" loading="lazy" />
                  </a>
                ))}
              </div>
            )}
            {(c.testimonial.name || c.testimonial.role) && (
              <p class="cs__feedback-who">
                <strong>{c.testimonial.name}</strong>
                {c.testimonial.role && <span>{c.testimonial.role}</span>}
              </p>
            )}
          </figure>
        )}

        {c.link && (
          <a class="btn" href={c.link.href} target="_blank" rel="noopener">
            {c.link.label} <Icon name="arrow" size={16} class="arrow" />
          </a>
        )}
      </article>
    </template>
  ))
}

<style is:global>
  .case {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .case::backdrop {
    background: rgba(17, 17, 17, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .case[open].is-in::backdrop {
    opacity: 1;
  }
  .case__sheet {
    position: absolute;
    inset: max(3vh, 16px) 0 0;
    margin-inline: auto;
    width: min(960px, 100%);
    background: #fff;
    border-radius: 24px 24px 0 0;
    box-shadow: 0 -20px 60px -20px rgba(0, 0, 0, 0.35);
    transform: translateY(100%);
    transition: transform 0.6s var(--ease);
    display: flex;
    flex-direction: column;
  }
  .case.is-in .case__sheet {
    transform: none;
  }
  .case__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--text);
    color: #fff;
    transition: transform 0.4s var(--ease);
  }
  .case__close:hover {
    transform: rotate(90deg);
  }
  .case__content {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(24px, 5vw, 56px) clamp(16px, 5vw, 56px) 80px;
  }

  .cs {
    display: grid;
    gap: clamp(28px, 4vw, 44px);
  }
  .cs__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin-bottom: 18px;
    padding-right: 56px;
  }
  .cs__brand {
    font-weight: 700;
    font-size: 13px;
    color: var(--muted);
  }
  .cs__title {
    font-size: clamp(1.8rem, 4.4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    text-transform: uppercase;
    margin: 6px 0 16px;
  }
  .cs__summary {
    color: var(--muted);
    font-size: 15px;
    max-width: 60ch;
  }
  .cs__cover {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 8;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .cs__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs__facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 0;
    padding-block: 18px;
    border-block: 1.5px solid var(--line);
  }
  .cs__facts dt {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cs__facts dd {
    margin: 4px 0 0;
    font-weight: 600;
  }
  .cs__block {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 16px;
  }
  .cs__block h3 {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cs__block h3::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin: 0 8px 2px 0;
    background: var(--orange);
  }
  .cs__block p {
    max-width: 62ch;
    font-size: 14.5px;
  }
  .cs__block--wide {
    grid-template-columns: 1fr;
  }
  /* rich text written in the dashboard */
  .cs__story {
    display: grid;
    gap: 14px;
    max-width: 68ch;
    font-size: 14.5px;
    line-height: 1.75;
  }
  .cs__story > * {
    margin: 0;
  }
  .cs__story h1,
  .cs__story h2,
  .cs__story h3,
  .cs__story h4 {
    margin-top: 14px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cs__story h1::before,
  .cs__story h2::before,
  .cs__story h3::before,
  .cs__story h4::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin: 0 8px 2px 0;
    background: var(--orange);
  }
  .cs__story :is(h1, h2, h3, h4):first-child {
    margin-top: 0;
  }
  .cs__story p,
  .cs__story li {
    color: var(--muted);
  }
  .cs__story strong {
    color: var(--text);
  }
  .cs__story ul,
  .cs__story ol {
    padding-left: 1.2em;
    display: grid;
    gap: 6px;
  }
  .cs__story ul {
    list-style: square;
  }
  .cs__story ol {
    list-style: decimal;
  }
  .cs__story a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cs__story blockquote > * {
    margin: 0;
  }
  .cs__story blockquote :is(h1, h2, h3, h4)::before {
    display: none;
  }
  .cs__story blockquote {
    display: grid;
    gap: 8px;
    padding-left: 16px;
    border-left: 3px solid var(--orange);
    font-style: italic;
  }
  .cs__story u {
    text-underline-offset: 3px;
  }
  /* tables from the editor: lined, padded, header row shaded, scrolls sideways on phones */
  .cs__story table {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: separate;
    border-spacing: 0;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.5;
  }
  .cs__story th,
  .cs__story td {
    min-width: 110px;
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
    color: var(--muted);
  }
  .cs__story th {
    background: var(--tint);
    color: var(--text);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  .cs__story tr > :last-child {
    border-right: 0;
  }
  .cs__story tbody tr:last-child > * {
    border-bottom: 0;
  }
  .cs__story tbody tr:nth-child(even) td {
    background: #fafaf8;
  }

  /* client feedback (optional, after the videos) */
  .cs__feedback {
    position: relative;
    display: grid;
    gap: 18px;
    margin: 0;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--radius);
    background: var(--tint);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cs__feedback-label {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cs__feedback-label::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin: 0 8px 2px 0;
    background: var(--orange);
  }
  .cs__feedback-mark {
    width: 30px;
    height: 22px;
    fill: var(--orange);
  }
  .cs__feedback blockquote {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.7;
    white-space: pre-line;
  }
  .cs__feedback-shots {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cs__feedback-shots a {
    display: block;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 14px 30px -18px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s var(--ease);
  }
  .cs__feedback-shots a:hover {
    transform: translateY(-3px);
  }
  .cs__feedback-shots img {
    display: block;
    width: auto;
    max-width: min(300px, 100%);
    max-height: 420px;
    object-fit: contain;
    background: #fff;
  }
  .cs__feedback-who {
    display: grid;
    gap: 2px;
    font-size: 12px;
    color: var(--muted);
  }
  .cs__feedback-who strong {
    font-size: 13px;
    color: var(--text);
  }
  .cs__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 12px;
  }
  .cs__gallery img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 14px;
  }
  .cs__results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
  }
  .cs__results li {
    display: grid;
    gap: 4px;
    padding: 20px;
    border-radius: 14px;
    background: var(--tint);
  }
  .cs__results strong {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .cs__results span {
    font-size: 12px;
    font-weight: 600;
  }
  /* bigger players → YouTube starts them at a higher quality */
  .cs__shorts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
  }
  @media (max-width: 760px) {
    .cs__facts {
      grid-template-columns: 1fr;
    }
    .cs__block {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    /* phones: one large player at a time, swipe sideways for the next */
    .cs__shorts {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(78vw, 320px);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: 4px;
    }
    .cs__shorts > * {
      scroll-snap-align: start;
    }
  }
</style>

<script>
  import { lenis } from '../scripts/motion';

  const dialog = document.querySelector<HTMLDialogElement>('[data-case-dialog]');
  if (dialog) {
    const content = dialog.querySelector<HTMLElement>('[data-case-content]')!;
    const cursor = document.querySelector<HTMLElement>('.cursor');
    let lastFocus: HTMLElement | null = null;

    const open = (slug: string, push = true) => {
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-case-template="${CSS.escape(slug)}"]`);
      if (!tpl) return false;
      lastFocus = document.activeElement as HTMLElement;
      content.replaceChildren(tpl.content.cloneNode(true));
      content.scrollTop = 0;
      dialog.showModal();
      cleaned = false;
      // the dialog sits in the browser's top layer, above everything — bring the cursor along
      if (cursor) dialog.append(cursor);
      lenis?.stop();
      requestAnimationFrame(() => dialog.classList.add('is-in'));
      if (push) history.replaceState(null, '', `#${slug}`);
      return true;
    };

    // runs once per close, whichever path closed the dialog
    let cleaned = true;
    const cleanup = () => {
      if (cleaned) return;
      cleaned = true;
      if (cursor) document.body.prepend(cursor);
      lenis?.start();
      if (location.hash) history.replaceState(null, '', location.pathname + location.search);
      lastFocus?.focus({ preventScroll: true });
    };
    const close = () => {
      dialog.classList.remove('is-in');
      setTimeout(() => {
        dialog.close();
        content.replaceChildren();
        cleanup();
      }, 450);
    };
    dialog.addEventListener('close', cleanup);
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    dialog.querySelector('[data-case-close]')!.addEventListener('click', close);
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    // lazy YouTube: swap the thumbnail for the iframe only when played
    content.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLElement>('[data-short]');
      if (!btn) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.short}?autoplay=1&playsinline=1&rel=0&modestbranding=1&vq=hd1080`;
      // vq asks YouTube to start in HD; the viewer can still change it from the player's settings
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.title = btn.getAttribute('aria-label') ?? 'YouTube video';
      // a <button> can't hold interactive content — swap it for a div with the same attributes
      const wrap = document.createElement('div');
      for (const a of btn.attributes) if (!/^(data-short|data-cursor|aria-label)$/.test(a.name)) wrap.setAttribute(a.name, a.value);
      wrap.append(iframe);
      btn.replaceWith(wrap);
    });

    document.addEventListener('click', (e) => {
      const trigger = (e.target as Element).closest<HTMLElement>('[data-case-open]');
      if (!trigger || e.metaKey || e.ctrlKey || e.shiftKey) return;
      if (open(trigger.dataset.caseOpen!)) e.preventDefault();
    });

    const fromHash = () => {
      const slug = decodeURIComponent(location.hash.slice(1));
      if (slug) open(slug, false);
    };
    fromHash();
  }
</script>
