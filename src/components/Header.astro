---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="header">
  <div class="header__side header__left">
    <span class="clock" data-clock data-tz={site.timezone} aria-label={`Local time in ${site.location}`}>--:--:--</span>
    <span class="loc"><Icon name="pin" size={13} /> {site.location}</span>
  </div>

  <nav class="nav" aria-label="Main">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={!item.external && isActive(item.href) ? 'page' : undefined}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener' : undefined}
              data-astro-prefetch={item.external ? 'false' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="header__side header__right">
    <a class="mail" href={`mailto:${site.email}`}>
      <span class="mail__text">{site.email}</span>
      <Icon name="arrow" size={14} class="mail__icon" />
    </a>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding-inline: var(--gutter);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.96) 55%, rgba(255, 255, 255, 0));
  }
  .header__left {
    display: flex;
    gap: 10px;
    align-items: center;
    font-variant-numeric: tabular-nums;
  }
  .loc {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .header__right {
    justify-self: end;
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1.5px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.4s var(--ease);
  }
  .mail:hover {
    background-size: 100% 1.5px;
  }

  .nav ul {
    display: flex;
    gap: 2px;
    padding: 4px;
    background: var(--orange);
    border-radius: 10px;
    box-shadow: 0 8px 24px -12px rgba(255, 95, 0, 0.6);
  }
  .nav a {
    display: block;
    padding: 5px 11px;
    border-radius: 7px;
    color: #fff;
    font-weight: 700;
    font-size: 13px;
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .nav a:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .nav a[aria-current='page'] {
    background: #fff;
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .header {
      font-size: 11.5px;
      grid-template-columns: 1fr 1fr;
    }
    .loc :global(svg) {
      display: none;
    }
    .nav {
      position: fixed;
      left: 50%;
      bottom: max(14px, env(safe-area-inset-bottom));
      transform: translateX(-50%);
      z-index: 60;
    }
    .nav ul {
      box-shadow: 0 10px 30px -8px rgba(255, 95, 0, 0.7);
    }
    .nav a {
      padding: 8px 10px;
      font-size: 12.5px;
    }
  }
  @media (max-width: 420px) {
    .mail__text {
      display: none;
    }
    .mail::before {
      content: 'Mail me';
    }
  }
  @media (max-width: 360px) {
    .nav a {
      padding: 8px 7px;
      font-size: 12px;
    }
  }
</style>
