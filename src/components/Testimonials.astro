---
import { testimonials } from '../data/testimonials';

const items = testimonials.filter((t) => !t.placeholder);
// second row starts halfway through so the two rows never show the same card side by side
const half = Math.ceil(items.length / 2);
const rows = [items, [...items.slice(half), ...items.slice(0, half)]];
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter((w) => /^[A-Za-z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0].toUpperCase())
    .join('');
---

<section class="testi section" aria-labelledby="testi-title" data-testi>
  <div class="wrap testi__head">
    <span class="eyebrow">Testimonials</span>
    <h2 class="h-section" id="testi-title">Words of praise from<br />people I've worked with</h2>
  </div>

  <div class="testi__stage">
    {
      rows.map((row, r) => (
        <div class="testi__row" data-row={r} data-dir={r === 0 ? 1 : -1}>
          <ul class="testi__track" data-track>
            {[0, 1].map((copy) =>
              row.map((t) => (
                <li class="quote" aria-hidden={copy ? 'true' : undefined}>
                  <svg class="quote__mark" viewBox="0 0 32 24" aria-hidden="true">
                    <path d="M0 24V14C0 6 4.5 1.3 12.6 0l1.3 3.2C9.3 4.6 7.2 7.4 7 11h6v13H0Zm18 0V14c0-8 4.5-12.7 12.6-14L32 3.2C27.3 4.6 25.2 7.4 25 11h6v13H18Z" />
                  </svg>
                  <blockquote>{t.quote}</blockquote>
                  <div class="quote__who">
                    <span class="quote__avatar">{initials(t.name)}</span>
                    <span>
                      <strong>{t.name}</strong>
                      <span class="quote__role">
                        {t.role}, {t.company}
                      </span>
                    </span>
                  </div>
                </li>
              )),
            )}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .testi__head {
    display: grid;
    justify-items: center;
    gap: 14px;
    text-align: center;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .testi__stage {
    display: grid;
    gap: clamp(14px, 1.6vw, 20px);
    max-width: calc(var(--maxw) + 2 * var(--gutter));
    margin-inline: auto;
    overflow: hidden;
    /* soft fade on both edges, like cards drifting in and out */
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }
  .testi__row {
    overflow: hidden;
  }
  .testi__track {
    --card: clamp(270px, 28vw, 360px);
    --gap: clamp(14px, 1.6vw, 20px);
    display: flex;
    gap: var(--gap);
    width: max-content;
    will-change: transform;
  }
  .quote {
    flex: 0 0 var(--card);
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(20px, 2vw, 26px);
    border-radius: var(--radius);
    background: var(--tint);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .quote__mark {
    width: 26px;
    height: 20px;
    fill: var(--orange);
  }
  .quote blockquote {
    flex: 1;
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .quote__who {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
  }
  .quote__who strong {
    display: block;
    font-size: 13px;
    font-weight: 800;
  }
  .quote__role {
    display: block;
    color: var(--muted);
    font-size: 11px;
  }
  .quote__avatar {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--text);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
  }
  @media (prefers-reduced-motion: reduce) {
    .testi__row {
      overflow-x: auto;
    }
  }
</style>

<script>
  import { gsap, reduced } from '../scripts/motion';

  /**
   * Each row slides one card at a time (pause → glide → pause), the two rows in
   * opposite directions. The track holds the cards twice, so it loops seamlessly.
   */
  document.querySelectorAll<HTMLElement>('[data-testi]').forEach((root) => {
    if (reduced) return;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
    const tls = rows.map((row) => {
      const track = row.querySelector<HTMLElement>('[data-track]')!;
      const dir = Number(row.dataset.dir);
      const count = track.children.length / 2;
      const step = () => {
        const card = track.children[0] as HTMLElement;
        return card.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0');
      };
      const tl = gsap.timeline({ repeat: -1, delay: dir > 0 ? 0 : 1.1 });
      for (let i = 1; i <= count; i++) {
        tl.to(track, {
          x: () => (dir > 0 ? -i * step() : -(count - i) * step()),
          duration: 0.9,
          ease: 'power3.inOut',
          delay: 1.8,
        });
      }
      // snap back to the start of the loop (identical frame, invisible)
      tl.set(track, { x: () => (dir > 0 ? 0 : -count * step()) });
      gsap.set(track, { x: dir > 0 ? 0 : -count * step() });
      tl.invalidate();
      return tl;
    });

    // pause while hovering (so people can read), and when off-screen
    root.addEventListener('pointerenter', () => tls.forEach((t) => t.pause()));
    root.addEventListener('pointerleave', () => tls.forEach((t) => t.resume()));
    new IntersectionObserver(([e]) => tls.forEach((t) => (e.isIntersecting ? t.resume() : t.pause()))).observe(root);
    addEventListener('resize', () => tls.forEach((t) => t.invalidate()));
  });
</script>
