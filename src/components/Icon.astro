---
interface Props {
  name: 'instagram' | 'linkedin' | 'mail' | 'arrow' | 'arrow-right' | 'close' | 'play' | 'plus' | 'pin';
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <path d="M8 10.5V16M8 7.6v.01M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.4-2.6s2.1.9 2.1 2.6V16" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="3" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {name === 'arrow' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'arrow-right' && <path d="M4 12h16m-6-6 6 6-6 6" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'play' && <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke="none" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
        <circle cx="12" cy="10" r="2.3" />
      </>
    )
  }
</svg>
