---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/noto-sans-devanagari/devanagari-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import Preloader from '../components/Preloader.astro';
import { site, url } from '../data/site';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import devaBold from '@fontsource/noto-sans-devanagari/files/noto-sans-devanagari-devanagari-700-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Show the Namaste → Hello → Kya line greeting (home only, once per session). */
  intro?: boolean;
}

const { title, description = site.description, intro = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    {intro && <link rel="preload" href={devaBold} as="font" type="font/woff2" crossorigin />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline define:vars={{ intro }}>
      var h = document.documentElement;
      h.classList.add('js');
      var seen = false;
      try {
        seen = sessionStorage.getItem('greeted') === '1';
      } catch (e) {}
      if (!intro || seen || matchMedia('(prefers-reduced-motion: reduce)').matches) h.classList.add('greeted');
      else {
        h.classList.add('preloading');
        setTimeout(function () {
          h.classList.remove('preloading');
        }, 3500);
      }
    </script>
  </head>
  <body>
    {intro && <Preloader />}
    <Cursor />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>

<style is:global>
  html.preloading,
  html.preloading body {
    overflow: hidden;
  }
</style>
